# ---------------------------------------------------------------------------
# AratReserve Reservation Services — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy to .env.local for local development (never commit real secrets).
# In production, configure public VITE_* variables in Cloudflare Pages build
# settings and private server-side variables as Cloudflare Pages Secrets.

# --- Public Client Variables (Safe for Browser / Vite Bundle) ---
VITE_SITE_URL="https://aratreserve.com"

# Dedicated AratReserve Supabase project (Stage 3+; never use CourtBook's project)
VITE_SUPABASE_URL="https://YOUR_ARATRESERVE_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ARATRESERVE_SUPABASE_ANON_KEY"

# Cloudflare Turnstile public site key for contact form spam protection (Stage 5)
VITE_TURNSTILE_SITE_KEY="YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY"

# --- Server-Side Only Variables (Cloudflare Pages Functions / Edge Secrets) ---
# NEVER prefix these with VITE_ or expose them in frontend code.
# Resend sending domain (aratreserve.com) is verified; email workflows activate in Stage 5.
SUPABASE_SERVICE_ROLE_KEY="YOUR_ARATRESERVE_SERVICE_ROLE_KEY"
RESEND_API_KEY="YOUR_RESEND_API_KEY"
INQUIRY_NOTIFY_EMAIL="YOUR_NOTIFICATION_EMAIL"
EMAIL_FROM="noreply@aratreserve.com"
TURNSTILE_SECRET_KEY="YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY"

# --- Google AI Studio Preview Runtime (Optional) ---
APP_URL="MY_APP_URL"
